digraph Framework {
  graph [rankdir=LR, splines=true, nodesep=0.22, ranksep=0.9, fontname="Liberation Sans", fontsize=15, newrank=true, pad=0.3, bgcolor="white"];
  node  [shape=plaintext, fontname="Liberation Sans", fontsize=11];
  edge  [color="#475569", penwidth=1.1, arrowsize=0.8];

  subgraph cluster_apps {
    label=<<B>Aplicações (parte variante)</B>>; labeljust=l; style="rounded,dashed"; color="#0f766e"; margin=14;
    "CongressoNacional" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#0f766e"><TR><TD BGCOLOR="#ecfdf5" CELLPADDING="6"><B>CongressoNacional</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ ID_APLICACAO = &quot;congresso&quot;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#6b7280">implementa os hot-spots</FONT><BR ALIGN="LEFT"/>+ definir_evento()<BR ALIGN="LEFT"/>+ criar_validador()<BR ALIGN="LEFT"/>+ criar_estrategia_alocacao()<BR ALIGN="LEFT"/>+ criar_formulario_avaliacao()<BR ALIGN="LEFT"/>+ criar_politica_decisao()<BR ALIGN="LEFT"/>+ criar_gerador_programacao()<BR ALIGN="LEFT"/>+ criar_canal_notificacao()<BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#6b7280">redefine os hooks</FONT><BR ALIGN="LEFT"/>+ criar_assistente()<BR ALIGN="LEFT"/>+ dados_de_exemplo()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "JornadaIniciacaoCientifica" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#0f766e"><TR><TD BGCOLOR="#ecfdf5" CELLPADDING="6"><B>JornadaIniciacaoCientifica</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ ID_APLICACAO = &quot;jornada&quot;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#6b7280">implementa os hot-spots</FONT><BR ALIGN="LEFT"/>+ definir_evento()<BR ALIGN="LEFT"/>+ criar_validador()<BR ALIGN="LEFT"/>+ criar_estrategia_alocacao()<BR ALIGN="LEFT"/>+ criar_formulario_avaliacao()<BR ALIGN="LEFT"/>+ criar_politica_decisao()<BR ALIGN="LEFT"/>+ criar_gerador_programacao()<BR ALIGN="LEFT"/>+ criar_canal_notificacao()<BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#6b7280">redefine os hooks</FONT><BR ALIGN="LEFT"/>+ ocultar_autores_na_revisao()<BR ALIGN="LEFT"/>+ dados_de_exemplo()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "Aplicação n" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#0f766e"><TR><TD BGCOLOR="#ecfdf5" CELLPADDING="6"><B>Aplicação n</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">(ex.: WorkshopIA, seção 6.5)<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#6b7280">implementa os hot-spots</FONT><BR ALIGN="LEFT"/>+ definir_evento()<BR ALIGN="LEFT"/>+ criar_...() para cada componente<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }

  subgraph cluster_framework {
    label=<<B>Estrutura interna do framework (parte invariante)</B>>; labeljust=l; style=rounded; color="#3730a3"; margin=14;
    "FrameworkEventoCientifico" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#3730a3"><TR><TD BGCOLOR="#e8eaf9" CELLPADDING="6"><FONT POINT-SIZE="10">«abstract»</FONT><BR/><B><I>FrameworkEventoCientifico</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ ID_APLICACAO : str<BR ALIGN="LEFT"/>+ servicos : ServicosSciEvent<BR ALIGN="LEFT"/>+ validador : IValidadorSubmissao<BR ALIGN="LEFT"/>+ alocacao : IEstrategiaAlocacao<BR ALIGN="LEFT"/>+ formulario : IFormularioAvaliacao<BR ALIGN="LEFT"/>+ politica_decisao : IPoliticaDecisao<BR ALIGN="LEFT"/>+ gerador_programacao : IGeradorProgramacao<BR ALIGN="LEFT"/>+ canal_notificacao : ICanalNotificacao<BR ALIGN="LEFT"/>+ assistente : IAssistente<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#6b7280">construtor: cria os componentes chamando os hot-spots</FONT><BR ALIGN="LEFT"/>+ FrameworkEventoCientifico(servicos)<BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#6b7280">métodos template (controle, @final)</FONT><BR ALIGN="LEFT"/>+ inicializar() : dict<BR ALIGN="LEFT"/>+ submeter_trabalho(dados) : ResultadoSubmissao<BR ALIGN="LEFT"/>+ alocar_revisores() : list<BR ALIGN="LEFT"/>+ registrar_revisao(alocacao_id, respostas, comentario) : ResultadoRevisao<BR ALIGN="LEFT"/>+ consolidar_decisoes() : list<BR ALIGN="LEFT"/>+ gerar_programacao() : dict<BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#6b7280">hot-spots (métodos abstratos)</FONT><BR ALIGN="LEFT"/><I>+ definir_evento() : dict</I><BR ALIGN="LEFT"/><I>+ criar_validador() : IValidadorSubmissao</I><BR ALIGN="LEFT"/><I>+ criar_estrategia_alocacao() : IEstrategiaAlocacao</I><BR ALIGN="LEFT"/><I>+ criar_formulario_avaliacao() : IFormularioAvaliacao</I><BR ALIGN="LEFT"/><I>+ criar_politica_decisao() : IPoliticaDecisao</I><BR ALIGN="LEFT"/><I>+ criar_gerador_programacao() : IGeradorProgramacao</I><BR ALIGN="LEFT"/><I>+ criar_canal_notificacao() : ICanalNotificacao</I><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#6b7280">métodos hook (implementação padrão)</FONT><BR ALIGN="LEFT"/>+ criar_assistente() : IAssistente<BR ALIGN="LEFT"/>+ ocultar_autores_na_revisao() : bool<BR ALIGN="LEFT"/>+ dados_de_exemplo() : dict<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "IAssistente" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#3730a3"><TR><TD BGCOLOR="#f3f4f6" CELLPADDING="6"><FONT POINT-SIZE="10">«interface»</FONT><BR/><B>IAssistente</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+ triar(submissao, evento) : dict</I><BR ALIGN="LEFT"/><I>+ meta_revisao(submissao, revisoes, decisao, evento) : str</I><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "SemAssistente" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#3730a3"><TR><TD BGCOLOR="#e8eaf9" CELLPADDING="6"><FONT POINT-SIZE="10">«Null Object»</FONT><BR/><B>SemAssistente</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ triar(submissao, evento) : None<BR ALIGN="LEFT"/>+ meta_revisao(...) : None<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "AssistenteAgentes" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#3730a3"><TR><TD BGCOLOR="#e8eaf9" CELLPADDING="6"><B>AssistenteAgentes</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- cliente : ClienteAgentes<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ triar(submissao, evento) : dict<BR ALIGN="LEFT"/>+ meta_revisao(submissao, revisoes, decisao, evento) : str<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "ICanalNotificacao" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#3730a3"><TR><TD BGCOLOR="#f3f4f6" CELLPADDING="6"><FONT POINT-SIZE="10">«interface»</FONT><BR/><B>ICanalNotificacao</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+ canal : str</I><BR ALIGN="LEFT"/><I>+ formatar(tipo, contexto) : Mensagem</I><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "NotificacaoMural" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#3730a3"><TR><TD BGCOLOR="#e8eaf9" CELLPADDING="6"><B>NotificacaoMural</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ canal = &quot;mural&quot;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ formatar(tipo, contexto) : Mensagem<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "NotificacaoEmail" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#3730a3"><TR><TD BGCOLOR="#e8eaf9" CELLPADDING="6"><B>NotificacaoEmail</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- remetente : str<BR ALIGN="LEFT"/>+ canal = &quot;email&quot;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ formatar(tipo, contexto) : Mensagem<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "IGeradorProgramacao" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#3730a3"><TR><TD BGCOLOR="#f3f4f6" CELLPADDING="6"><FONT POINT-SIZE="10">«interface»</FONT><BR/><B>IGeradorProgramacao</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+ gerar(aceitos, evento, tentativa) : Programa</I><BR ALIGN="LEFT"/><I>+ verificar_conflitos(programa) : list[str]</I><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "ProgramacaoSequencial" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#3730a3"><TR><TD BGCOLOR="#e8eaf9" CELLPADDING="6"><B>ProgramacaoSequencial</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- sala : str<BR ALIGN="LEFT"/>- por_bloco : int<BR ALIGN="LEFT"/>- limite : str<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ gerar(aceitos, evento, tentativa) : Programa<BR ALIGN="LEFT"/>+ verificar_conflitos(programa) : list[str]<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "ProgramacaoPorTrilhas" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#3730a3"><TR><TD BGCOLOR="#e8eaf9" CELLPADDING="6"><B>ProgramacaoPorTrilhas</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- salas : list[str]<BR ALIGN="LEFT"/>- artigos_por_sessao : int<BR ALIGN="LEFT"/>- duracao, intervalo : int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ gerar(aceitos, evento, tentativa) : Programa<BR ALIGN="LEFT"/>+ verificar_conflitos(programa) : list[str]<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "IPoliticaDecisao" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#3730a3"><TR><TD BGCOLOR="#f3f4f6" CELLPADDING="6"><FONT POINT-SIZE="10">«interface»</FONT><BR/><B>IPoliticaDecisao</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+ decidir(submissao, notas) : Decisao</I><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "DecisaoPorNotaMinima" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#3730a3"><TR><TD BGCOLOR="#e8eaf9" CELLPADDING="6"><B>DecisaoPorNotaMinima</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- nota_minima : float<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ decidir(submissao, notas) : Decisao<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "DecisaoPorMediaPonderada" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#3730a3"><TR><TD BGCOLOR="#e8eaf9" CELLPADDING="6"><B>DecisaoPorMediaPonderada</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- limiar_oral, limiar_poster : float<BR ALIGN="LEFT"/>- limiar_divergencia : float<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ decidir(submissao, notas) : Decisao<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "IFormularioAvaliacao" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#3730a3"><TR><TD BGCOLOR="#f3f4f6" CELLPADDING="6"><FONT POINT-SIZE="10">«interface»</FONT><BR/><B>IFormularioAvaliacao</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+ criterios() : list[Criterio]</I><BR ALIGN="LEFT"/><I>+ validar(respostas, comentario) : list[str]</I><BR ALIGN="LEFT"/><I>+ calcular_nota(respostas) : float</I><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "FormularioNotaUnica" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#3730a3"><TR><TD BGCOLOR="#e8eaf9" CELLPADDING="6"><B>FormularioNotaUnica</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _criterio : Criterio<BR ALIGN="LEFT"/>- comentario_minimo : int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ criterios() : list[Criterio]<BR ALIGN="LEFT"/>+ validar(respostas, comentario) : list[str]<BR ALIGN="LEFT"/>+ calcular_nota(respostas) : float<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "FormularioPonderado" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#3730a3"><TR><TD BGCOLOR="#e8eaf9" CELLPADDING="6"><B>FormularioPonderado</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- _criterios : list[Criterio]<BR ALIGN="LEFT"/>- comentario_minimo : int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ criterios() : list[Criterio]<BR ALIGN="LEFT"/>+ validar(respostas, comentario) : list[str]<BR ALIGN="LEFT"/>+ calcular_nota(respostas) : float<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "IEstrategiaAlocacao" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#3730a3"><TR><TD BGCOLOR="#f3f4f6" CELLPADDING="6"><FONT POINT-SIZE="10">«interface»</FONT><BR/><B>IEstrategiaAlocacao</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+ alocar(submissoes, revisores, carga_atual) : list[dict]</I><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "AlocacaoRoundRobin" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#3730a3"><TR><TD BGCOLOR="#e8eaf9" CELLPADDING="6"><B>AlocacaoRoundRobin</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- n : int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ alocar(submissoes, revisores, carga_atual) : list[dict]<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "AlocacaoPorAfinidade" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#3730a3"><TR><TD BGCOLOR="#e8eaf9" CELLPADDING="6"><B>AlocacaoPorAfinidade</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- n : int<BR ALIGN="LEFT"/>- evitar_mesma_instituicao : bool<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ alocar(submissoes, revisores, carga_atual) : list[dict]<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "IValidadorSubmissao" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#3730a3"><TR><TD BGCOLOR="#f3f4f6" CELLPADDING="6"><FONT POINT-SIZE="10">«interface»</FONT><BR/><B>IValidadorSubmissao</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><I>+ validar(submissao, evento) : list[str]</I><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "ValidadorSimples" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#3730a3"><TR><TD BGCOLOR="#e8eaf9" CELLPADDING="6"><B>ValidadorSimples</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- max_palavras : int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ validar(submissao, evento) : list[str]<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
    "ValidadorRigoroso" [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#3730a3"><TR><TD BGCOLOR="#e8eaf9" CELLPADDING="6"><B>ValidadorRigoroso</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- min_palavras, max_palavras : int<BR ALIGN="LEFT"/>- min_kw, max_kw : int<BR ALIGN="LEFT"/>- max_autores : int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ validar(submissao, evento) : list[str]<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  }

  "CongressoNacional" -> "FrameworkEventoCientifico" [arrowhead=empty, arrowsize=1.2];
  "JornadaIniciacaoCientifica" -> "FrameworkEventoCientifico" [arrowhead=empty, arrowsize=1.2];
  "Aplicação n" -> "FrameworkEventoCientifico" [arrowhead=empty, arrowsize=1.2, style=dashed];
  "FrameworkEventoCientifico" -> "IAssistente" [style=dashed, arrowhead=vee];
  "IAssistente" -> "SemAssistente" [style=dashed, dir=back, arrowtail=empty, arrowsize=1.1];
  "IAssistente" -> "AssistenteAgentes" [style=dashed, dir=back, arrowtail=empty, arrowsize=1.1];
  "FrameworkEventoCientifico" -> "ICanalNotificacao" [style=dashed, arrowhead=vee];
  "ICanalNotificacao" -> "NotificacaoMural" [style=dashed, dir=back, arrowtail=empty, arrowsize=1.1];
  "ICanalNotificacao" -> "NotificacaoEmail" [style=dashed, dir=back, arrowtail=empty, arrowsize=1.1];
  "FrameworkEventoCientifico" -> "IGeradorProgramacao" [style=dashed, arrowhead=vee];
  "IGeradorProgramacao" -> "ProgramacaoSequencial" [style=dashed, dir=back, arrowtail=empty, arrowsize=1.1];
  "IGeradorProgramacao" -> "ProgramacaoPorTrilhas" [style=dashed, dir=back, arrowtail=empty, arrowsize=1.1];
  "FrameworkEventoCientifico" -> "IPoliticaDecisao" [style=dashed, arrowhead=vee];
  "IPoliticaDecisao" -> "DecisaoPorNotaMinima" [style=dashed, dir=back, arrowtail=empty, arrowsize=1.1];
  "IPoliticaDecisao" -> "DecisaoPorMediaPonderada" [style=dashed, dir=back, arrowtail=empty, arrowsize=1.1];
  "FrameworkEventoCientifico" -> "IFormularioAvaliacao" [style=dashed, arrowhead=vee];
  "IFormularioAvaliacao" -> "FormularioNotaUnica" [style=dashed, dir=back, arrowtail=empty, arrowsize=1.1];
  "IFormularioAvaliacao" -> "FormularioPonderado" [style=dashed, dir=back, arrowtail=empty, arrowsize=1.1];
  "FrameworkEventoCientifico" -> "IEstrategiaAlocacao" [style=dashed, arrowhead=vee];
  "IEstrategiaAlocacao" -> "AlocacaoRoundRobin" [style=dashed, dir=back, arrowtail=empty, arrowsize=1.1];
  "IEstrategiaAlocacao" -> "AlocacaoPorAfinidade" [style=dashed, dir=back, arrowtail=empty, arrowsize=1.1];
  "FrameworkEventoCientifico" -> "IValidadorSubmissao" [style=dashed, arrowhead=vee];
  "IValidadorSubmissao" -> "ValidadorSimples" [style=dashed, dir=back, arrowtail=empty, arrowsize=1.1];
  "IValidadorSubmissao" -> "ValidadorRigoroso" [style=dashed, dir=back, arrowtail=empty, arrowsize=1.1];
}
