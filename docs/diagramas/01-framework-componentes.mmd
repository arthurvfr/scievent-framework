classDiagram
    direction LR

    class FrameworkEventoCientifico {
        <<abstract>>
        +ID_APLICACAO : str
        +MAX_TENTATIVAS_PROGRAMACAO : int
        +servicos : ServicosSciEvent
        +inicializar() dict
        +submeter_trabalho(dados) ResultadoSubmissao
        +alocar_revisores() list
        +registrar_revisao(alocacao_id, respostas, comentario) ResultadoRevisao
        +consolidar_decisoes() list
        +gerar_programacao() dict
        +descrever_componentes() list
        +definir_evento()* dict
        +criar_validador()* IValidadorSubmissao
        +criar_estrategia_alocacao()* IEstrategiaAlocacao
        +criar_formulario_avaliacao()* IFormularioAvaliacao
        +criar_politica_decisao()* IPoliticaDecisao
        +criar_gerador_programacao()* IGeradorProgramacao
        +criar_canal_notificacao()* ICanalNotificacao
        +criar_assistente() IAssistente
        +ocultar_autores_na_revisao() bool
        +dados_de_exemplo() dict
    }

    class IValidadorSubmissao { <<interface>> }
    class IEstrategiaAlocacao { <<interface>> }
    class IFormularioAvaliacao { <<interface>> }
    class IPoliticaDecisao { <<interface>> }
    class IGeradorProgramacao { <<interface>> }
    class ICanalNotificacao { <<interface>> }
    class IAssistente { <<interface>> }

    class ServicosSciEvent {
        +eventos
        +submissoes
        +revisoes
        +programacao
        +notificacoes
        +agentes
    }

    class CongressoNacional {
        ID_APLICACAO = "congresso"
    }
    class JornadaIniciacaoCientifica {
        ID_APLICACAO = "jornada"
    }


    FrameworkEventoCientifico o-- "1" IValidadorSubmissao : validador
    FrameworkEventoCientifico o-- "1" IEstrategiaAlocacao : alocacao
    FrameworkEventoCientifico o-- "1" IFormularioAvaliacao : formulario
    FrameworkEventoCientifico o-- "1" IPoliticaDecisao : politica_decisao
    FrameworkEventoCientifico o-- "1" IGeradorProgramacao : gerador_programacao
    FrameworkEventoCientifico o-- "1" ICanalNotificacao : canal_notificacao
    FrameworkEventoCientifico o-- "1" IAssistente : assistente
    FrameworkEventoCientifico --> ServicosSciEvent : usa

    FrameworkEventoCientifico <|-- CongressoNacional
    FrameworkEventoCientifico <|-- JornadaIniciacaoCientifica

    IValidadorSubmissao <|.. ValidadorRigoroso
    IValidadorSubmissao <|.. ValidadorSimples
    IEstrategiaAlocacao <|.. AlocacaoPorAfinidade
    IEstrategiaAlocacao <|.. AlocacaoRoundRobin
    IFormularioAvaliacao <|.. FormularioPonderado
    IFormularioAvaliacao <|.. FormularioNotaUnica
    IPoliticaDecisao <|.. DecisaoPorMediaPonderada
    IPoliticaDecisao <|.. DecisaoPorNotaMinima
    IGeradorProgramacao <|.. ProgramacaoPorTrilhas
    IGeradorProgramacao <|.. ProgramacaoSequencial
    ICanalNotificacao <|.. NotificacaoEmail
    ICanalNotificacao <|.. NotificacaoMural
    IAssistente <|.. AssistenteAgentes
    IAssistente <|.. SemAssistente
